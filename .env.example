# ==============================================================================
# Startup Foundry - Environment Variables Example Template
# Copy this file to .env before starting the platform
# ==============================================================================

# Database Connection (Local Docker default: postgresql://postgres:postgre@postgres:5432/startup-foundary)
DATABASE_URL=postgresql://postgres:postgre@localhost:5432/startup-foundary

# JWT Secret Key for Session Authentication (Change to a secure random string)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Backend API URL (Used by Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# System Admin Credentials (For initial admin login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Ollama AI Model (Remote EC2 Instance or Local Ollama)
OLLAMA_BASE_URL=http://16.113.91.178:11434
OLLAMA_MODEL=qwen2.5:7b

# Firebase Authentication (Optional)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=startup-foundary.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=startup-foundary
